# Desktop metadata
.DS_Store
._*
Thumbs.db

# Build outputs and per-user IDE state; keep shared project files trackable.
/build/
/obj/
/DerivedData/
/com.apple.DeveloperTools/
/.local/
__pycache__/
*.pyc
*.o
*.obj
*.app/
*.dSYM/
*.xcuserstate
xcuserdata/
.vs/

# Runtime session and flythrough records are local development data.
/bin/data/record/address/

# Executables belong outside the tracked runtime assets.
/bin/*
!/bin/data/
